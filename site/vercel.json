{
  "cleanUrls": true,
  "headers": [
    { "source": "/(fonts|img|audio|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ],
  "rewrites": [
    { "source": "/r/:code", "destination": "/r" },
    { "source": "/cadeau/:id", "destination": "/cadeau" }
  ]
}
